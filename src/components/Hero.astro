---
import Pip from "./Pip.astro";
import StatusBadge from "./StatusBadge.astro";
import { getShowcase } from "../lib/showcase";
import type { ShellData } from "../scripts/shell";

const data = await getShowcase();
const byName = new Map(data.repos.map((r) => [r.name, r]));
// The featured repos, in the order showcase/config.json lists them: the hero's jump-links.
const top = data.featured.map((name) => byName.get(name)).filter((r) => r !== undefined);

// What the terminal knows about: every project on the page, featured ones first (src/scripts/shell.ts).
const firstSentence = (text: unknown) => /^(.+?[.!?])(\s|$)/.exec(String(text ?? "").trim())?.[1] ?? String(text ?? "").trim();
const shell: ShellData = {
  github: data.user.url,
  // What `neofetch` prints about the workshop.
  facts: {
    shipped: data.repos.filter((r) => r.status === "done").length,
    languages: data.facets.languages.slice(0, 3).map((f) => f.label),
  },
  projects: [...top, ...data.repos.filter((r) => !r.featured)].map((r) => ({
    name: r.name,
    title: r.title,
    tagline: firstSentence(r.blurb || r.description),
    url: r.url,
    live: r.homepage,
    featured: r.featured,
    downloads: ((r.release as { downloads?: { label: string }[] } | null)?.downloads ?? []).map((d) => d.label),
  })),
};
// What the workshop makes, for the ticker under the hero.
const ticker = ["Idle games", "Desktop pets", "Built with AI", "ASCII art", "Pixel hamsters", "Stock rankers", "Made for fun"];
// JSON inside <script> must not be able to close the tag.
const shellJson = JSON.stringify(shell).replace(/</g, "\\u003c");
---

<div class="hero-wrap">
  <section class="hero container">
    <div class="hero__head">
      <StatusBadge user={data.user} />
      <p class="eyebrow">No. 01 · Things I've vibe-coded</p>
      <h1>I make little things <span class="bean-word">for fun.</span></h1>
    </div>
    <div class="hero__copy">
      <p class="lede">
        Hi, I'm <strong>Charles</strong>. These are the projects I've <strong>vibe-coded</strong>: a slot machine
        run by a hamster, a jellybean who lives on your desktop, a stock ranker, a lot of ASCII art and whatever I'm tinkering with next.
        Some are finished, some are very much not.
      </p>
      <nav class="hero-jump" aria-label="Jump to a project">
        <a class="btn btn--primary" href="#projects">See the projects</a>
        {top.map((repo) => <a class="btn btn--ghost btn--sm" href={`#project-${repo.name}`}>{repo.title}</a>)}
        <a class="btn btn--ghost btn--sm" href="#workbench">Everything else</a>
      </nav>
    </div>

    <div class="hero-art">
      <div class="terminal">
        <div class="terminal__bar">
          <span class="terminal__dots" aria-hidden="true"><i></i><i></i><i></i></span>
          <span class="terminal__title">charles@workshop: ~</span>
        </div>
        <div class="terminal__body" data-shell>
          <p class="terminal__line"><span class="prompt">charles@workshop<span class="prompt__path">:~</span><span class="prompt__sym">$</span></span><span class="type" style="--chars: 6; --delay: 0.3s">whoami</span></p>
          <p class="terminal__line terminal__out reveal" style="--delay: 0.75s">charles · vibe-coder · makes things for fun</p>
          <p class="terminal__line reveal" style="--delay: 1.1s"><span class="prompt">charles@workshop<span class="prompt__path">:~</span><span class="prompt__sym">$</span></span><span class="type" style="--chars: 13; --delay: 1.3s">ls ~/projects</span></p>
          <p class="terminal__line terminal__out reveal" style="--delay: 2.15s">{top.map((repo, i) => <Fragment>{i > 0 && "\u00a0 "}<a href={`#project-${repo.name}`}>{repo.name}/</a></Fragment>)}</p>
          <div class="terminal__line reveal" style="--delay: 2.45s" data-shell-prompt><span class="prompt">you@workshop<span class="prompt__path">:~</span><span class="prompt__sym">$</span></span><span class="cursor" aria-hidden="true"></span></div>
        </div>
      </div>
      <span class="burst" aria-hidden="true"><span><b>100%</b>vibe-coded</span></span>
    </div>
  </section>

  <div class="container runway">
    <Pip label="Fig. 1 · Pip, jellybean" hint="click him to change the ink" />
  </div>

  {/* The words run past twice so the loop has no seam; the second run is hidden from screen readers. */}
  <div class="ticker">
    <div class="ticker__track">
      {[false, true].map((again) => (
        <ul aria-hidden={again ? "true" : undefined}>
          {ticker.map((word) => <li>{word}</li>)}
        </ul>
      ))}
    </div>
  </div>
</div>

<script type="application/json" id="shell-data" set:html={shellJson} />

<script>
  import "../scripts/shell";
</script>
