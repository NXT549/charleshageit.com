---
import Pip from "./Pip.astro";
import StatusBadge from "./StatusBadge.astro";
import { getShowcase } from "../lib/showcase";

const data = await getShowcase();
const byName = new Map(data.repos.map((r) => [r.name, r]));
// The featured repos, in the order showcase/config.json lists them: the hero's jump-links.
const top = data.featured.map((name) => byName.get(name)).filter((r) => r !== undefined);
---

<section class="hero container">
  <div>
    <StatusBadge user={data.user} />
    <p class="eyebrow">hi! welcome to my workshop</p>
    <h1>I make little things <span class="text-pop wiggle">for fun.</span></h1>
    <p class="lede">
      Hi, I'm <strong>Charles</strong>. These are the projects I've <strong>vibe-coded</strong>: a slot machine
      run by a hamster, a jellybean who lives on your desktop, and whatever I'm tinkering with next.
      Some are finished, some are very much not.
    </p>
    <nav class="hero-jump" aria-label="Jump to a project">
      <a class="btn btn--primary" href="#projects">See the projects</a>
      {top.map((repo) => <a class="btn btn--ghost" href={`#project-${repo.name}`}>{repo.title}</a>)}
      <a class="btn btn--ghost" href="#workbench">Everything else</a>
    </nav>
    <div class="hero-tags">
      <span class="tag">🐹 idle games</span>
      <span class="tag">🫘 desktop pets</span>
      <span class="tag">🤖 built with AI</span>
    </div>
  </div>

  <div class="terminal glass">
    <div class="terminal__bar">
      <span class="terminal__dots" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="terminal__title">charles@workshop: ~</span>
    </div>
    <div class="terminal__body">
      <p class="terminal__line"><span class="prompt">charles@workshop<span class="prompt__path">:~</span><span class="prompt__sym">$</span></span><span class="type" style="--chars: 6; --delay: 0.3s">whoami</span></p>
      <p class="terminal__line terminal__out reveal" style="--delay: 0.75s">charles · vibe-coder · Redlands, Brisbane</p>
      <p class="terminal__line reveal" style="--delay: 1.1s"><span class="prompt">charles@workshop<span class="prompt__path">:~</span><span class="prompt__sym">$</span></span><span class="type" style="--chars: 13; --delay: 1.3s">ls ~/projects</span></p>
      <p class="terminal__line terminal__out reveal" style="--delay: 2.15s">{top.map((repo, i) => <Fragment>{i > 0 && "\u00a0 "}<a href={`#project-${repo.name}`}>{repo.name}/</a></Fragment>)}</p>
      <p class="terminal__line reveal" style="--delay: 2.45s"><span class="prompt">charles@workshop<span class="prompt__path">:~</span><span class="prompt__sym">$</span></span><span class="cursor" aria-hidden="true"></span></p>
    </div>
    <Pip />
  </div>
</section>

<style>
  .hero-jump { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-5); }
</style>
