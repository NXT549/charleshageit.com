---
interface Props {
  /** The title block's sheet number. */
  sheet?: string;
}

const { sheet = "01–04" } = Astro.props;
---

<footer class="site-footer">
  <div class="container">
    <div class="titleblock">
      <div><small>Drawn by</small>Charles, with too many snacks</div>
      <div><small>Scale</small>1:1, mostly</div>
      <div><small>Source</small><a href="https://github.com/NXT549/charleshageit.com">This site's code</a></div>
      <div><small>Sheet</small>{sheet}</div>
    </div>
  </div>
</footer>
