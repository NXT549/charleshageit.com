---
interface Props {
  /** Prefix for the home page's in-page links: "" on the home page, "/" anywhere else. */
  home?: string;
  /** The link to mark as the current page: "projects", "log" or "about". */
  current?: string;
}

const { home = "", current } = Astro.props;

// The drawing index: the sheets of the site. On phones they fold into a menu.
const links = [
  { key: "projects", label: "Projects", href: `${home}#projects` },
  { key: "workbench", label: "Workbench", href: `${home}#workbench` },
  { key: "log", label: "Log", href: "/log/" },
  { key: "about", label: "About", href: "/about/" },
];
---

<header class="site-header">
  <div class="container">
    <a class="brand" href={home ? "/" : "#top"}><img src="/img/pip-icon.png" alt="" width="30" height="30" /><span>Charles's Workshop</span></a>
    <nav class="nav" aria-label="Main">
      <ul class="nav__links">
        {links.map((l) => <li><a href={l.href} aria-current={l.key === current ? "page" : undefined}>{l.label}</a></li>)}
      </ul>
      <details class="nav__menu">
        <summary class="btn btn--ghost btn--sm">Sheets<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 6l5 5 5-5" /></svg></summary>
        <ul class="nav__drawer">
          {
            links.map((l, i) => (
              <li>
                <a href={l.href} aria-current={l.key === current ? "page" : undefined}>
                  <span class="nav__num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </details>
      <a class="btn btn--ghost btn--sm" href="https://github.com/NXT549">
        <svg viewBox="0 0 16 16" aria-hidden="true" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
        <span class="nav__gh">GitHub</span>
      </a>
    </nav>
  </div>
</header>

<script>
  // Fold the phone menu away once something in it is picked, or on Escape / a tap elsewhere.
  const menu = document.querySelector<HTMLDetailsElement>(".nav__menu");
  if (menu) {
    menu.addEventListener("click", (e) => {
      if ((e.target as Element).closest("a")) menu.open = false;
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && menu.open) {
        menu.open = false;
        menu.querySelector("summary")?.focus();
      }
    });
    document.addEventListener("click", (e) => {
      if (menu.open && !menu.contains(e.target as Node)) menu.open = false;
    });
  }
</script>
