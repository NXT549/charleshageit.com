---
// "Live" GitHub status: when Charles last pushed, and where. Built from the showcase data, so it's as
// fresh as the last deploy; src/scripts/showcase.js turns the date into "3 days ago" in the browser.
import type { Showcase } from "../lib/showcase";

interface Props {
  user: Showcase["user"];
}

const { user } = Astro.props;
const DAY = 86_400_000;
const pushed = user.lastPushAt ? new Date(user.lastPushAt) : null;
const fresh = pushed !== null && Date.now() - pushed.getTime() < 14 * DAY;
const date = pushed?.toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" });
---

{
  pushed && (
    <a class:list={["hero-status", fresh && "hero-status--live"]} href={user.url}>
      <span class="hero-status__label">{fresh ? "building" : "last seen"} on GitHub</span>
      <span class="hero-status__sep" aria-hidden="true">·</span>
      <span class="hero-status__detail">
        pushed{user.lastPushRepo && <> to <b>{user.lastPushRepo}</b></>}{" "}
        <time datetime={pushed.toISOString()} data-relative>{date}</time>
      </span>
    </a>
  )
}

<style>
  .hero-status {
    display: inline-flex; flex-wrap: wrap; align-items: center; gap: 2px 8px;
    margin-bottom: var(--space-5); padding: 7px 14px 7px 12px;
    font: 500 var(--text-xs) / 1.3 var(--font-mono); letter-spacing: 0.02em;
    color: var(--ink); background: var(--paper-3); border: var(--rule); border-radius: var(--radius-full);
    text-decoration: none;
  }
  .hero-status:hover { background: var(--ink); color: var(--paper); }
  .hero-status::before { content: ""; width: 9px; height: 9px; border-radius: 50%; background: var(--ink-faint); }
  .hero-status--live::before { background: var(--spot); box-shadow: 0 0 0 1.5px var(--ink); animation: live 2.4s ease-in-out infinite; }
  @keyframes live { 50% { scale: 0.6; } }
  .hero-status b { font-weight: 700; }
  @media (max-width: 480px) {
    .hero-status__label, .hero-status__sep { display: none; }
  }
</style>
