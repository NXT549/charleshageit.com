---
// Fig. 3 on the home page: a taste of the sketchbook, with the rest one click away on /ascii/.
import AsciiFigure from "./AsciiFigure.astro";
import { pieceById } from "../lib/ascii";

const candles = pieceById("candles")!;
const walk = pieceById("pip-walk")!;
---

<section id="sketchbook" class="section container">
  <header class="section-head">
    <p class="eyebrow">Fig. 3 · Sketchbook</p>
    <h2><span class="text-pop">Drawn in plain text</span></h2>
    <p class="sub">
      No pictures here, only letters and punctuation. Pip is drawn one character per pixel, and the chart is one of the
      loading scenes from Stock Review.
    </p>
  </header>
  <div class="sketch">
    <AsciiFigure piece={candles} interval={380} note="a market, loading" />
    <div class="sketch__side">
      <AsciiFigure piece={walk} big interval={300} note="on his way" />
      <p class="sketch__text">
        Make a banner from your own name, or type <code>ascii</code> in the terminal at the top. Every picture in the
        sketchbook copies as plain text.
      </p>
      <div class="sketch__actions">
        <a class="btn btn--primary" href="/ascii/">Open the sketchbook</a>
        <a class="btn btn--ghost" href="/ascii/#banner">Make a banner</a>
      </div>
    </div>
  </div>
</section>
