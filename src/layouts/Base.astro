---
import "../styles/tokens.css";
import "../styles/theme.css";
import "../styles/showcase.css";
import "../styles/page.css";
import geistSans from "../fonts/Geist-Variable.woff2?url";
import geistMono from "../fonts/GeistMono-Variable.woff2?url";
import { SITE } from "../lib/site";

interface Props {
  title?: string;
  description?: string;
  /** Social card image, as a site path or an absolute URL. */
  image?: string;
  imageAlt?: string;
  /** False for pages that aren't really anywhere, like the 404: no canonical URL or og:url. */
  canonical?: boolean;
}

const {
  title = SITE.title,
  description = SITE.description,
  image = "/og.png",
  imageAlt = `${SITE.name}: ${SITE.shortDescription}`,
  canonical: hasCanonical = true,
} = Astro.props;

const canonical = hasCanonical ? new URL(Astro.url.pathname, Astro.site) : null;
const imageUrl = new URL(image, Astro.site);

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": new URL("/#website", Astro.site).href,
      url: new URL("/", Astro.site).href,
      name: SITE.name,
      description: SITE.description,
      inLanguage: SITE.lang,
      author: { "@id": new URL("/#me", Astro.site).href },
    },
    {
      "@type": "Person",
      "@id": new URL("/#me", Astro.site).href,
      name: SITE.author,
      url: new URL("/", Astro.site).href,
      sameAs: [SITE.githubUrl],
    },
  ],
};
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0b2240" />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/img/pip-icon.png" />
    <link rel="apple-touch-icon" href="/img/pip-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <link rel="preload" href={geistSans} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={geistMono} as="font" type="font/woff2" crossorigin />
    <slot name="head" />
  </head>
  <body>
    <slot />
    <script>
      import "../scripts/fx.js";
      import "../scripts/showcase.js";
    </script>
  </body>
</html>
